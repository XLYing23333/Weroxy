[Unit]
Description=Weroxy host firewall agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/weroxy-Server firewall-agent --config /etc/weroxy/firewall-agent.json
User=root
Group=root
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_CHOWN CAP_DAC_OVERRIDE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RuntimeDirectory=weroxy-firewall
RuntimeDirectoryMode=0755
StateDirectory=weroxy-firewall
StateDirectoryMode=0700
ReadWritePaths=/run/weroxy-firewall /var/lib/weroxy-firewall
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
