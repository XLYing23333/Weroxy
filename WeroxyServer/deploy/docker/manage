#!/bin/sh
set -eu
base=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if ! command -v python3 >/dev/null 2>&1; then
  printf '%s\n' 'Python 3.10+ is required. / 请先安装 Python 3.10 或以上。' >&2
  exit 1
fi
if [ -f "$base/deploy/console.py" ]; then
  exec python3 "$base/deploy/console.py" "$@"
fi
exec python3 "$base/console.py" "$@"
